{
  "name": "csu-one",
  "description": "CSU-One: campus issue reporting for Cagayan State University – Carig Campus",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=terminal.local vite --host 0.0.0.0",
    "templates": "node scripts/templates.mjs",
    "build": "node scripts/templates.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@vitejs/plugin-react": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/leaflet": "^1.9.20",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "cross-env": "^10.1.0",
    "htmlparser2": "^9.1.0",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "latest"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
